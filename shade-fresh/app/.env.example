# mock USDC mint (6 decimals)
VITE_USDC_MINT=DANN41Tukr829a3zzXy81QpzfqNyYendveiuvwDnho4R
# devnet RPC (QuickNode/Helius recommended — public devnet is rate-limited)
VITE_PROVIDER_ENDPOINT=https://YOUR-QUICKNODE-DEVNET-URL/

# Backend faucet URL (the shade-faucet service on your VPS). When set, the UI shows a
# "get test USDC + gas" button so fresh wallets can trade. Leave empty to hide it.
# e.g. https://api.tradeshade.online   (faucet listens on :8787 — proxy or open the port)
VITE_FAUCET_URL=

# Optional — MagicBlock Ephemeral Rollup endpoints (default to the Magic Router)
# VITE_ER_RPC=https://devnet-router.magicblock.app
# VITE_ER_WS=wss://devnet-router.magicblock.app
