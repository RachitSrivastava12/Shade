# ---- Shade backend config ----
# Copy to `.env` and fill in. All three services (crank, maker, faucet) read this.

# Path to the wallet keypair JSON. This wallet must be:
#   - the program authority / cranker
#   - the maker (holds inventory)  AND
#   - the USDC mint authority (so the maker + faucet can mint mock USDC)
# On the VPS, upload your id.json and point this at it (chmod 600).
ANCHOR_WALLET=/root/.config/solana/id.json

# Devnet RPC. Public devnet is rate-limited — use a QuickNode/Helius devnet URL.
PROVIDER_ENDPOINT=https://YOUR-QUICKNODE-DEVNET-URL/

# Mock USDC mint (6 decimals) the wallet above has mint authority over.
USDC_MINT=DANN41Tukr829a3zzXy81QpzfqNyYendveiuvwDnho4R

# ---- optional: MagicBlock Ephemeral Rollup endpoints (defaults are the Magic Router) ----
# EPHEMERAL_PROVIDER_ENDPOINT=https://devnet-router.magicblock.app
# EPHEMERAL_WS_ENDPOINT=wss://devnet-router.magicblock.app
# VALIDATOR=MAS1Dt9qreoRMQ14YQuhg8UTZMMzDdKhmkZMECCzk57

# ---- optional: crank ----
# CRANK_TICK_MS=6000

# ---- optional: market maker ----
# MM_LEVELS=4              # price levels per side
# MM_SIZE=10              # size units per level (10 = 0.01 SOL)
# MM_SPREAD_BPS=8         # half-spread of the innermost level
# MM_STEP_BPS=6           # gap between levels
# MM_REQUOTE_BPS=12       # re-centre when the live price drifts this far
# MM_TICK_MS=7000
# MM_MIN_BASE_SOL=0.1     # top up wSOL inventory below this
# MM_MIN_QUOTE_USDC=50    # top up USDC inventory below this
# MM_TOPUP_BASE_SOL=0.3
# MM_TOPUP_QUOTE_USDC=200

# ---- optional: faucet ----
# FAUCET_PORT=8787
# FAUCET_USDC=1000          # mock USDC per claim
# FAUCET_SOL=0.05           # devnet SOL per claim (gas + wrapping)
# FAUCET_COOLDOWN_MS=21600000   # 6h per address
# FAUCET_CORS_ORIGIN=*      # set to https://tradeshade.online to lock it down
