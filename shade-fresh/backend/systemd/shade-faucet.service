[Unit]
Description=Shade test faucet (mock USDC + gas)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/shade-backend
EnvironmentFile=/opt/shade-backend/.env
ExecStart=/opt/shade-backend/node_modules/.bin/ts-node src/faucet.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
