# Postgres connection string (Neon / Supabase / Railway / Render all work).
# Hosted Postgres requires SSL (the server enables it by default).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Port the API listens on (Render/Railway set this automatically).
PORT=3000

# Set to "disable" only for a local, non-SSL Postgres.
# PGSSL=disable
